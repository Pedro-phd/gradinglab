{
  "name": "gradinglab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ffmpeg.mjs && next dev",
    "build": "node scripts/copy-ffmpeg.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:typed": "eslint --config eslint.typed.config.mjs .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:typed && pnpm lint:rules && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "mediabunny": "1.66.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.6",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-drizzle": "^0.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  }
}
